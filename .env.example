# ---------------------------------------------------------------------------
# Phira+ PPF — public build-time environment (all values are PUBLIC-safe).
# Copy to `.env` locally. Never put secrets (Phira tokens, PPB session JWT,
# GitHub client secret, push keys) in this file or anywhere in the frontend.
#
# Frozen cross-repo contract: contracts/README.md (Contract-Freeze v0)
# ---------------------------------------------------------------------------

# PPB REST API base (CORS-credentialed).
NUXT_PUBLIC_API_BASE=https://api-phira.htadiy.com

# PPB auth gateway base (login/reauth/refresh/root).
# The client NEVER sees Phira access/refresh tokens — auth is delegated to PPB.
NUXT_PUBLIC_AUTH_BASE=https://api-phira.htadiy.com

# Canonical site URL (used by @nuxtjs/seo for sitemap/OG/canonical).
NUXT_PUBLIC_SITE_URL=https://phira.htadiy.com
